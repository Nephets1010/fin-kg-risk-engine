# ---------------------------------------------------------------------------
# fin-kg-risk-engine — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and MUST NOT
# be committed. Every secret below is read from the environment at runtime;
# no credential is ever hard-coded in the source tree.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
FIN_KG_ENV=development              # development | staging | production
FIN_KG_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
FIN_KG_LOG_FORMAT=json              # json | console
FIN_KG_API_HOST=0.0.0.0
FIN_KG_API_PORT=8000
FIN_KG_WORKERS=4
FIN_KG_API_KEY=                      # optional; when set, X-API-Key is required
FIN_KG_CORS_ORIGINS=["http://localhost:8501"]

# --- Neo4j -----------------------------------------------------------------
FIN_KG_NEO4J_URI=bolt://localhost:7687
FIN_KG_NEO4J_USER=neo4j
FIN_KG_NEO4J_PASSWORD=               # REQUIRED in production; use a secret manager
FIN_KG_NEO4J_DATABASE=neo4j
FIN_KG_NEO4J_MAX_CONNECTION_POOL=50
FIN_KG_NEO4J_CONNECTION_TIMEOUT=30
FIN_KG_NEO4J_BATCH_SIZE=5000

# --- Redis (event stream / job queue) -------------------------------------
FIN_KG_REDIS_URL=redis://localhost:6379/0
FIN_KG_REDIS_PASSWORD=
FIN_KG_REDIS_STREAM_MAXLEN=100000

# --- Risk engine -----------------------------------------------------------
FIN_KG_RISK_MAX_HOPS=3               # transmission path depth limit
FIN_KG_RISK_DECAY=0.6                # per-hop score decay factor
FIN_KG_RISK_ALERT_THRESHOLD=60.0     # 0-100, alert fires at or above this
FIN_KG_RISK_CRITICAL_THRESHOLD=85.0
FIN_KG_RISK_RULES_PATH=rules/risk_rules.yaml

# --- Ingestion -------------------------------------------------------------
FIN_KG_INGESTION_BATCH_SIZE=2000
FIN_KG_INGESTION_DATA_DIR=data/samples
FIN_KG_INGESTION_CHECKPOINT_DIR=data/checkpoints
FIN_KG_TUSHARE_TOKEN=                # optional; only for the Tushare source

# --- LLM (optional; the platform degrades to template mode without it) -----
FIN_KG_LLM_ENABLED=false
FIN_KG_LLM_API_BASE=https://api.openai.com/v1
FIN_KG_LLM_API_KEY=
FIN_KG_LLM_MODEL=gpt-4o-mini
FIN_KG_LLM_TIMEOUT=60

# --- Observability ---------------------------------------------------------
FIN_KG_METRICS_ENABLED=true
FIN_KG_METRICS_PORT=9100
FIN_KG_ALERT_WEBHOOK_URL=            # optional; receives risk alert payloads

# --- Scheduler -------------------------------------------------------------
FIN_KG_SCHEDULER_ENABLED=true
FIN_KG_SCHEDULER_TIMEZONE=Asia/Shanghai
FIN_KG_JOB_INGEST_CRON=0 2 * * *
FIN_KG_JOB_RESCORE_CRON=0 */6 * * *
FIN_KG_JOB_PROPAGATE_CRON=*/15 * * * *
FIN_KG_JOB_RESEARCH_CRON=0 3 * * *
